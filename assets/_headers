# Cloudflare Pages headers.
#
# NOTE: this file lives in assets/, not public/ — vite.config.js overrides
# publicDir to 'assets', so anything placed in public/ is silently not served.

# DO NOT mark /assets/* immutable. Content-hashed filenames make it tempting, but
# Pages has no atomic swap: during a deploy a request for a not-yet-uploaded asset
# used to be answered by the SPA fallback with index.html at status 200. An
# immutable directive then pinned that HTML to the asset's URL in the edge cache —
# for a year, for every visitor. That took the site down; a browser gets HTML where
# it expects a module and nothing renders.
#
# The real fix is assets/404.html: with a 404 page present, Pages answers unmatched
# paths with a genuine 404 instead of index.html at 200, so there is no successful
# response to cache against a missing asset. This site routes entirely on the hash
# (#/writeups/...), so every real URL is "/" and the SPA fallback was never needed.
#
# The short TTL here is belt-and-braces: if a bad response ever is cached, it
# expires on its own rather than needing a purge.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate

# The HTML entry point must never be cached, or a browser keeps loading an old
# index.html that references asset filenames a new deploy has already removed.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
